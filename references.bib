@techreport{fribergHallbartVaxtskyddMojliga2023,
  title = {H\aa llbart V\"axtskydd : M\"ojliga Indikatorer Och Ekonomiska Aspekter Av Diversifiering},
  shorttitle = {H\aa llbart V\"axtskydd},
  author = {Friberg, Hanna and Rosenqvist, H{\aa}kan and B{\"o}tzl, Fabian A. and Lundin, Ola},
  year = 2023,
  institution = {Sveriges lantbruksuniversitet},
  doi = {10.54612/a.16lr9mr84t},
  urldate = {2026-08-14},
  abstract = {H\aa llbar utveckling handlar om att v\"arna och nyttja de resurser vi har p\aa{} ett s\"att som g\"or att dagens behov uppfylls utan negativ p\aa verkan p\aa{} framtida generationers m\"ojlighet att uppfylla sina behov. Samtliga tre dimensioner av h\aa llbarhet - ekologisk, ekonomisk och social - beh\"over inkluderas. I ett h\aa llbart v\"axtskyddsarbete efterstr\"avas en minimerad f\"orlust av sk\"orden p\aa{} grund av skadeg\"orare och ogr\"as med en s\aa{} liten negativ p\aa verkan av insatserna som m\"ojligt p\aa{} m\"anniskor, djur och milj\"o, samtidigt som produktionen bedrivs konkurrenskraftigt, l\"onsamt och s\"akert ur ett arbetsmilj\"operspektiv. \AA r 2022 publicerades en kunskapssammanst\"allning om h\aa llbara odlingssystem med avseende p\aa{} v\"axtskydd (Lundin och Friberg, 2022). D\"ar konstaterades att det vore av stort v\"arde om fler indikatorer f\"or h\aa llbart v\"axtskydd kunde utvecklas, f\"or att vi i framtiden ska kunna skatta h\aa llbarheten utifr\aa n fler dimensioner \"an vad som g\"ors idag. Den belyste ocks\aa{} behovet av en ut\"okad ekonomisk analys av h\aa llbarhet kopplat till sk\"ordebortfall och till diversifiering genom val av olika gr\"odor i v\"axtodlingen. Den h\"ar rapporten bygger vidare p\aa{} kunskapssammanst\"allningens slutsatser genom en f\"ordjupad diskussion om hur nya indikatorer som speglar utveckling av skadeg\"orare, de skador de orsakar samt resistensutveckling kan anv\"andas f\"or att skatta h\aa llbarheten i svensk v\"axtproduktion. Rapporten presenterar ocks\aa{} ekonomiska analyser utifr\aa n bek\"ampningskostnader och sk\"ordebortfall, samt ekonomiska aspekter p\aa{} \"okad diversifiering genom \"okad odlad m\aa ngfald.  Baserat p\aa{} v\aa rt arbete f\"oresl\aa r vi att skadeg\"orardata som sedan 1989 samlats in via Jordbruksverkets v\"axtskyddscentraler anv\"ands f\"or indikatorer f\"or skadeg\"orare i jordbruksgr\"odor, och presenterar i rapporten ett f\"orslag p\aa{} urval av 16 viktiga skadeg\"orare samt en modell f\"or att f\"olja deras f\"orekomst \"over tid. Eftersom bakomliggande data finns sammanst\"allda och tillg\"angliggjorda kan en s\aa dan indikator till\"ampas redan i dagsl\"aget. En indikator f\"or sk\"ordebortfall orsakat av skadeg\"orare kan utvecklas genom att bearbeta data fr\aa n de bek\"ampningsf\"ors\"ok som \aa rligen genomf\"ors, och rapporten presenterar en modell f\"or hur en s\aa dan indikator kan ber\"aknas utifr\aa n dessa f\"ors\"oksdata. Till skillnad fr\aa n indikatorerna f\"or skadeg\"orarf\"orekomst finns inte data fr\aa n bek\"ampningsf\"ors\"ok sammanst\"allda och tillg\"angliggjorda i dagsl\"aget, utan kr\"aver avsev\"ard bearbetning innan en s\aa dan indikator kan ber\"aknas. Vi anser det d\"arf\"or angel\"aget att en s\aa dan sammanst\"allning g\"ors, s\aa{} att \"aven en indikator f\"or sk\"ordef\"orluster kan anv\"andas. Bek\"ampningsf\"ors\"oken \"ar ocks\aa{} begr\"ansade avseende vilka gr\"odor och skadeg\"orare som finns tillr\"ackligt representerade. Vi ser de f\"ors\"ok som avser sjukdomar i h\"ostvete och v\aa rkorn som mest l\"ampliga f\"or utvecklingen av framtida indikatorer, medan liknande f\"ors\"ok f\"or skadeinsekter i dagsl\"aget \"ar alltf\"or f\aa{} f\"or att utg\"ora en s\"aker grund till motsvarande ber\"akningar. Vi f\"oresl\aa r ocks\aa{} att de resistenstester som genomf\"ors f\"or herbicider, fungicider och insekticider i Sverige sammanfattas till en indikator f\"or resistensutvecklingen som speglar v\"axtskyddets evolution\"ara h\aa llbarhet.  Ekonomiska ber\"akningar som gjordes utifr\aa n bek\"ampningsf\"ors\"ok i h\"ostvete och v\aa rkorn visade p\aa{} stor skillnad i l\"onsamhet vid kemisk bek\"ampning av sjukdomar orsakade av svampar f\"or \aa r med h\"ogt sjukdomstryck j\"amf\"ort med \aa r med l\aa gt sjukdomstryck. Resultaten belyser vikten av god precision och s\"akerhet i prognoser och beslutsst\"od kring kemisk bek\"ampning f\"or en god behovsanpassning av bek\"ampningen.  Diversifiering genom en \"okad m\aa ngfald av odlade gr\"odor kan b\aa de minska lantbruksf\"oretagets risk och \"oka lantbruksf\"oretagets l\"onsamhet n\"ar diversifiering sker med tillr\"ackligt l\"onsamma gr\"odor. F\"or att gynna en diversifiering kan det vara effektivt att ha ekonomiskt st\"od direkt kopplat till gr\"odan, i de fall d\"ar det finns befintliga avs\"attningsm\"ojligheter i stor skala. N\"ar avs\"attningsm\"ojligheterna beh\"over f\"orb\"attras kan st\"od ges f\"or att vidaref\"or\"adla gr\"odan. Dessutom kan det beh\"ovas hj\"alp med organisation och kunskap kring nya gr\"odor. D\"armed kan det vara l\"ampligt med olika st\"odutformning f\"or olika situationer d\"ar olika st\"od kan komplettera varandra.}
}

